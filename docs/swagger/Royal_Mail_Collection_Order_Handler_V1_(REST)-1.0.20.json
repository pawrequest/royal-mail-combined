    "productFamily": {
      "properties": {
        "productFamily": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/productFamilyDef"
          }
        }
      },
      "required": [
        "productFamily"
      ]
    },
    "productFamilyDef": {
      "type": "object",
      "description": "node of product family",
      "properties": {
        "barcode": {
          "type": "string",
          "description": "Item BarCode Id",
          "example": "WL902730228GB"
        },
        "productFamilyName": {
          "type": "string",
          "description": "Product Family Name",
          "example": "Special Delivery"
        },
        "accountNumber": {
          "type": "string",
          "description": "Account Number",
          "example": "0983764876"
        }
      }
    },
    "validateSubscriptionResponse": {
      "type": "object",
      "properties": {
        "productFamily": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/productFamilyResponseDef"
          }
        }
      },
      "required": [
        "productFamily"
      ]
    },
    "productFamilyResponseDef": {
      "type": "object",
      "description": "node of product family",
      "properties": {
        "productFamilyName": {
          "type": "string",
          "description": "Product Family Name",
          "example": "Special Delivery"
        },
        "status": {
          "type": "string",
          "description": "Response Status",
          "example": "200"
        },
        "subscription": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subscriptionDef"
          }
        },
        "account": {
          "$ref": "#/definitions/accountDef"
        }
      },
      "required": [
        "productFamilyName",
        "status"
      ]
    },
    "accountDef": {
      "type": "object",
      "description": "node of account",
      "properties": {
        "accountNumber": {
          "type": "string",
          "description": "Account Number",
          "example": "0983764876"
        },
        "subscription": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subscriptionDef"
          }
        },
        "agreementLine": {
          "$ref": "#/definitions/agreementLineDef"
        },
        "contract": {
          "$ref": "#/definitions/contractCodeDef"
        }
      },
      "required": [
        "accountNumber",
        "agreementLine"
      ]
    },
    "contractCodeDef": {
      "type": "object",
      "description": "Contract details",
      "properties": {
        "contractCode": {
          "type": "string",
          "description": "Contract code",
          "example": "TRN9876543"
        },
        "subscription": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractSubscriptionDef"
          }
        }
      }
    },
    "agreementLineDef": {
      "type": "object",
      "description": "node of agreementLine",
      "properties": {
        "isContractAvailableForCCProduct": {
          "type": "string",
          "description": "Is Contract available for CC product",
          "example": true
        }
      },
      "required": [
        "isContractAvailableForCCProduct"
      ]
    },
    "subscriptionDef": {
      "type": "object",
      "description": "node of subscription data",
      "properties": {
        "name": {
          "type": "string",
          "description": "node of subscription data",
          "example": "isEligibleForCC"
        },
        "value": {
          "type": "boolean",
          "description": "Return the subscription value",
          "example": true
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "contractSubscriptionDef": {
      "type": "object",
      "description": "node of subscription data",
      "properties": {
        "name": {
          "type": "string",
          "description": "node of subscription data",
          "example": "isCovidEnabled"
        },
        "value": {
          "type": "boolean",
          "description": "Return the subscription value",
          "example": true
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "getAvailableSlotsResponse": {
      "type": "object",
      "properties": {
        "taskSlots": {
          "$ref": "#/definitions/taskSlotsDef"
        }
      }
    },
    "taskSlotsDef": {
      "description": "Node of slots data",
      "type": "object",
      "properties": {
        "slotDetails": {
          "$ref": "#/definitions/slotDetailsDef"
        },
        "datewiseSlots": {
          "$ref": "#/definitions/datewiseSlotsDef"
        }
      }
    },
    "slotDetailsDef": {
      "description": "Node of the details data",
      "type": "object",
      "properties": {
        "dps": {
          "type": "string",
          "description": "Delivery point suffix",
          "example": "SL64DU1Z"
        },
        "deliveryOfficeId": {
          "type": "number",
          "description": "Functional location id of Delivery office",
          "example": 962680198
        },
        "itemCount": {
          "type": "number",
          "description": "count of Item.",
          "example": 3
        },
        "tokenId": {
          "type": "string",
          "description": "Toekn Id.",
          "example": "123489020101234"
        },
        "tokenIdExpiryTime": {
          "type": "string",
          "format": "datetime",
          "description": "Token id expiry time, within which it should be used to create task. This will be populated with the date time in ISO 8601 subset format.",
          "example": "2020-01-24T06:00:00Z"
        }
      }
    },
    "datewiseSlotsDef": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/slotDateDef"
      }
    },
    "slotDateDef": {
      "type": "object",
      "properties": {
        "slotDate": {
          "type": "string",
          "format": "date",
          "description": "Node of slot dates",
          "example": "2020-01-26"
        },
        "estimatedWindow": {
          "$ref": "#/definitions/estimatedWindowDef"
        }
      }
    },
    "estimatedWindowDef": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "example": "10:50",
          "description": "the start of the estimated delivery window"
        },
        "endTime": {
          "type": "string",
          "example": "14:50",
          "description": "the end of the estimated delivery window"
        },
        "EDWVisibility": {
          "type": "number",
          "example": 1,
          "description": "EDW Visibility"
        }
      }
    }
  },
  "parameters": {
    "X-RMG-Date-Time": {
      "name": "X-RMG-Date-Time",
      "type": "string",
      "format": "date",
      "required": true,
      "in": "header",
      "description": "This should be populated with the date time in ISO 8601 subset format below when the message was generated. Eg. 2016-10-20T10:04:00+01:00 YYYY-MM-DDThh:mm:ss±hh:mm (To be used when there is an offset to GMT) YYYY-MM-DDThh:mm:ssZ  (To be used when value is in GMT)"
    },
    "Accept": {
      "name": "Accept",
      "type": "string",
      "required": true,
      "in": "header",
      "description": "Content-Types that are acceptable for the response. Eg. application/json"
    },
    "X-RMG-Idempotency-Key": {
      "name": "X-RMG-Idempotency-Key",
      "type": "string",
      "required": false,
      "in": "header",
      "minLength": 0,
      "maxLength": 256,
      "description": "Identifier to help denote whether the request is idempotent Eg: ANON:www.w3.org:j6oAOxCWZh/CD723LGeXlf-01:34"
    }
  },
