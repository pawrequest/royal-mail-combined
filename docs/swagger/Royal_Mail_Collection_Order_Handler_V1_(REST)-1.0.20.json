  "paths": {
    "/slots": {
      "get": {
        "tags": [
          "Get Available Slots"
        ],
        "summary": "Gets the available slots to book the order collection",
        "description": "To get the available slots for order collection as per the customers request.",
        "operationId": "order.getAvailableSlots",
        "parameters": [
          {
            "name": "dps",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "delivery point suffix details."
          },
          {
            "name": "itemCount",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "item/items count."
          },
          {
            "name": "carrier",
            "in": "query",
            "type": "string",
            "enum": [
              "RM",
              "PFW"
            ],
            "required": false,
            "description": "carrier short name."
          },
          {
            "$ref": "#/parameters/X-RMG-Date-Time"
          },
          {
            "$ref": "#/parameters/Accept"
          },
          {
            "$ref": "#/parameters/X-RMG-Idempotency-Key"
          }
        ],
        "responses": {
          "200": {
            "description": "200 OK.",
            "schema": {
              "$ref": "#/definitions/getAvailableSlotsResponse"
            }
          },
          "400": {
            "description": "Bad request. A malformed request has been received.",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/400"
                }
              ]
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/401"
            }
          },
          "404": {
            "description": "Not Found.",
            "schema": {
              "$ref": "#/definitions/404NotFound"
            }
          },
          "405": {
            "description": "Method Not Allowed.",
            "schema": {
              "$ref": "#/definitions/405"
            }
          },
          "500": {
            "description": "All server errors EXCEPT for 503. An unexpected error has occurred.",
            "schema": {
              "$ref": "#/definitions/500"
            }
          },
          "503": {
            "description": "Service Unavailable. \nThe API is currently unavailable.",
            "schema": {
              "$ref": "#/definitions/503"
            }
          }
        }
      }
    },
    "/productfamily/subscription": {
      "post": {
        "tags": [
          "Product Family Subscription"
        ],
        "summary": "Validate subscription to book the order collection",
        "description": "To validate the subscription as per the customers.",
        "operationId": "order.validateSubscription",
        "parameters": [
          {
            "name": "productFamily",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/productFamily"
            }
          },
          {
            "$ref": "#/parameters/X-RMG-Date-Time"
          },
          {
            "$ref": "#/parameters/Accept"
          }
        ],
        "responses": {
          "200": {
            "description": "200 OK.",
            "examples": {
              "application/json": {
                "productFamily": [
                  {
                    "productFamilyName": "Special Delivery",
                    "status": "200",
                    "subscription": [
                      {
                        "name": "isEligibleForCC",
                        "value": true
                      },
                      {
                        "name": "isEligibleForSafeplace",
                        "value": true
                      },
                      {
                        "name": "isEligibleForCCLabelFree",
                        "value": true
                      }
                    ],
                    "account": {
                      "accountNumber": "983764876",
                      "subscription": [
                        {
                          "name": "isEligibleForCC",
                          "value": true
                        }
                      ],
                      "agreementLine": {
                        "isContractAvailableForCCProduct": true
                      },
                      "contract": {
                        "contractCode": "TRN9876543",
                        "subscription": [
                          {
                            "name": "isCovidEnabled",
                            "value": true
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "schema": {
              "$ref": "#/definitions/validateSubscriptionResponse"
            }
          },
          "400": {
            "description": "Bad request. A malformed request has been received.",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/400"
                }
              ]
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/401"
            }
          },
          "404": {
            "description": "Not Found.",
            "schema": {
              "$ref": "#/definitions/404"
            }
          },
          "405": {
            "description": "Method Not Allowed.",
            "schema": {
              "$ref": "#/definitions/405"
            }
          },
          "500": {
            "description": "All server errors EXCEPT for 503. An unexpected error has occurred.",
            "schema": {
              "$ref": "#/definitions/500"
            }
          },
          "503": {
            "description": "Service Unavailable. \nThe API is currently unavailable.",
            "schema": {
              "$ref": "#/definitions/503"
            }
          }
        }
      }
    }
  },
