{
  "swagger": "2.0",
  "info": {
    "x-ibm-name": "royal-mail-collection-order-handler-v1-rest",
    "title": "Royal Mail Collection Order Handler V1 (REST)",
    "version": "1.0.20",
    "description": "Royal Mail Collection Order handler API exposes a REST service that allows Royal Mail customers to help in booking the doorstep collections. The purpose of this API is to allow Royal Mail customers to check the available slots and validate the subscription."
  },
  "basePath": "/collectionorders/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "description": "OAuth access token required. Valid access tokens can be retrieved from the Royal Mail Login API at *http://api.royalmail.net/login/v1/tokens*. Use the Authorization header Bearer scheme to send the access token in the following format \"Authorization: Bearer access_token\"",
      "flow": "password",
      "scopes": {},
      "tokenUrl": "https://Host_Address/Org_Segment/sb/oauth-end/oauth2/token",
      "type": "oauth2",
      "x-ibm-oauth-provider": "oauth-8dccd0a537e1faf77d8584c7796c351b",
      "x-scopeValidate": {
        "tls-profile": "",
        "url": ""
      }
    },
    "Client-Id": {
      "description": "Royal Mail Internal API Gateway unique client identifier.",
      "in": "header",
      "name": "X-IBM-Client-Id",
      "type": "apiKey"
    },
    "Client-Secret": {
      "description": "Royal Mail Internal API Gateway unique client secret.",
      "in": "header",
      "name": "X-IBM-Client-Secret",
      "type": "apiKey"
    }
  },
  "security": [
